# Site routing shared by the production and local Caddyfiles.
#
# One address for everything: https://HUB_DOMAIN/
#   /<code>/...   a meeting: the ask service maps the code to the hall that registered it, and
#                 Caddy proxies to that hall's frp tunnel -> its Solin meeting web server
#   anything else the ask service: landing page, hall API, status, health check
{$HUB_DOMAIN} {
	@internal path /internal/*
	respond @internal 404

	# Meeting codes use 2-9 and the consonants (see ask.py, MEETING_CODE); ask checks the length.
	@meeting path_regexp ^/[2-9bcdfghjkmnpqrstvwxyz]+(/.*)?$
	handle @meeting {
		# Ask answers unknown, retired and not-yet-open codes itself (that response goes straight
		# to the visitor); for an open meeting it returns the hall's tunnel port. copy_headers first
		# deletes any client-supplied X-Solin-Hall-Port, so it cannot be spoofed.
		forward_auth 127.0.0.1:{$ASK_PORT:7400} {
			uri /internal/route
			copy_headers X-Solin-Hall-Port
		}
		reverse_proxy 127.0.0.1:{http.request.header.X-Solin-Hall-Port} {
			header_up -X-Solin-Hall-Port
			# Stream responses as they come (lobby long-poll / server-sent updates).
			flush_interval -1
			# On a Caddy config reload, keep existing WebSockets (meetings) open instead of
			# closing them immediately; they finish on their own.
			stream_close_delay 8h
		}
	}

	handle {
		reverse_proxy 127.0.0.1:{$ASK_PORT:7400}
	}

	# The tunnel dropped between the route check and the connection.
	handle_errors 502 {
		header Retry-After 5
		respond "The meeting's connection to the hub dropped for a moment. Please retry in a few seconds." 503
	}
}
