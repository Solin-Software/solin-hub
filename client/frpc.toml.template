# frpc configuration for a meeting. Solin writes this file (substituting the ${...} values) and
# supervises `frpc -c frpc.toml` while the meeting is open. It dials OUT to the hub, so it works
# behind CGNAT.
#
#   ${HUB_ADDR}      hub host name or IP (e.g. hub.example.org or 203-0-113-10.sslip.io)
#   ${HUB_FRP_PORT}  frps bind port on the hub (FRP_BIND_PORT in hub.env, default 7000)
#   ${FRP_TOKEN}     shared frps token (FRP_TOKEN in hub.env; GET /api/hub hands it out)
#   ${CODE}          the meeting code; the meeting is https://<HUB_DOMAIN>/${CODE}
#   ${SECRET}        the code's secret (the hub stores only its sha256)
#   ${LOCAL_PORT}    the port of Solin's meeting web server on this PC (plain HTTP)
serverAddr = "${HUB_ADDR}"
serverPort = ${HUB_FRP_PORT}
auth.method = "token"
auth.token = "${FRP_TOKEN}"
# Keep retrying forever if the hub is unreachable.
loginFailExit = false
# Leave `user` unset: frp would prefix the proxy name with it and the hub would refuse the proxy.
transport.tcpMux = true
transport.protocol = "tcp"
log.to = "console"
log.level = "info"

# Proves to the hub's plugin that this is the code's owner (checked on NewProxy).
metadatas.code = "${CODE}"
metadatas.secret = "${SECRET}"

[[proxies]]
# Must be exactly the code, type "tcp" (raw TCP: no HTTP proxy timeouts on long WebSockets).
name = "${CODE}"
type = "tcp"
localIP = "127.0.0.1"
localPort = ${LOCAL_PORT}
# 0 = let the hub choose; the hub always picks the port.
remotePort = 0
